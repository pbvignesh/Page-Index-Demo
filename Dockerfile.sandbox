# The isolated image the agent's analysis code runs in.
# Only pandas is available; the container is started with --network none,
# capped memory/CPU/pids, and a non-root user (see app/sandbox.py).
FROM python:3.11-slim
RUN pip install --no-cache-dir pandas==2.2.2
RUN useradd -m sandbox
USER sandbox
WORKDIR /work
