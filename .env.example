# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/pageindex
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Optional: point at a gateway/proxy instead of api.anthropic.com
ANTHROPIC_BASE_URL=
# Docker image name for the analysis sandbox (built from Dockerfile.sandbox)
SANDBOX_IMAGE=pageindex-sandbox
# SEC requires a descriptive User-Agent with contact info
SEC_USER_AGENT=Page-Index-Demo contact@example.com
